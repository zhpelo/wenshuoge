{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wenshuoge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "wenshuoge"
    }
  ],
  "d1_databases": [
    {
      "binding": "METRICS",
      "database_name": "wenshuoge-metrics",
      "database_id": "52acb277-13a2-44d3-a435-ed35bd40c0b6",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "www.wenshuoge.com",
      "custom_domain": true
    }
  ]
}
